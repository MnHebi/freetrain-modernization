{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:freetrain:renderer-oracle:paired-comparison:v1",
  "title": "FreeTrain official-versus-reconstructed comparison metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalStatus",
    "fixtureId",
    "captureId",
    "officialPrimaryMetadata",
    "reconstructedPrimaryMetadata",
    "sharedSaveSha256",
    "environmentEquivalence",
    "deterministicRegions",
    "gdiFontReview",
    "differences",
    "unexplainedDifferenceCount",
    "cleanSnapshotReproduction",
    "comparisonMethod",
    "reviewer",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "approvalStatus": { "enum": ["candidate", "approved"] },
    "fixtureId": { "$ref": "#/$defs/stableId" },
    "captureId": { "$ref": "#/$defs/stableId" },
    "officialPrimaryMetadata": {
      "type": "string",
      "pattern": "^metadata/official-release/primary/.+\\.json$"
    },
    "reconstructedPrimaryMetadata": {
      "type": "string",
      "pattern": "^metadata/reconstructed-legacy/primary/.+\\.json$"
    },
    "sharedSaveSha256": { "$ref": "#/$defs/sha256" },
    "environmentEquivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "comparedFields", "notes"],
      "properties": {
        "result": { "enum": ["exact-recorded-match", "different"] },
        "comparedFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "deterministicRegions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["regionId", "result", "differentPixelCount", "classification", "notes"],
        "properties": {
          "regionId": { "$ref": "#/$defs/stableId" },
          "result": { "enum": ["exact-match", "different"] },
          "differentPixelCount": { "type": "integer", "minimum": 0 },
          "classification": { "$ref": "#/$defs/classification" },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gdiFontReview": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["regionId", "classification", "notes"],
        "properties": {
          "regionId": { "$ref": "#/$defs/stableId" },
          "classification": { "$ref": "#/$defs/classification" },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classification", "regionId", "description", "disposition"],
        "properties": {
          "classification": { "$ref": "#/$defs/classification" },
          "regionId": { "$ref": "#/$defs/stableId" },
          "description": { "type": "string", "minLength": 1 },
          "disposition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unexplainedDifferenceCount": { "type": "integer", "minimum": 0 },
    "cleanSnapshotReproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "officialMetadata",
        "officialResult",
        "reconstructedMetadata",
        "reconstructedResult"
      ],
      "properties": {
        "required": { "type": "boolean" },
        "officialMetadata": {
          "type": ["string", "null"]
        },
        "officialResult": { "enum": ["not-required", "exact-match", "different"] },
        "reconstructedMetadata": {
          "type": ["string", "null"]
        },
        "reconstructedResult": { "enum": ["not-required", "exact-match", "different"] }
      }
    },
    "comparisonMethod": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "notes": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "classification": {
      "enum": [
        "exact-match",
        "gdi-font-platform-sensitive",
        "package-resource-difference",
        "plugin-version-payload-difference",
        "debug-release-configuration-difference",
        "runtime-environment-difference",
        "historical-release-source-mismatch",
        "reconstructed-build-defect",
        "unexplained"
      ]
    }
  }
}
