{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:freetrain:renderer-oracle:capture-metadata:v2",
  "title": "FreeTrain paired legacy-oracle screenshot metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalStatus",
    "fixtureId",
    "captureId",
    "runKind",
    "oracleId",
    "rendererOracle",
    "originatingSave",
    "saveSha256",
    "freeTrainRevision",
    "package",
    "environment",
    "state",
    "interaction",
    "capture",
    "comparison",
    "provenanceNotes"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "approvalStatus": { "enum": ["candidate", "approved"] },
    "fixtureId": { "$ref": "#/$defs/stableId" },
    "captureId": { "$ref": "#/$defs/stableId" },
    "runKind": { "enum": ["primary", "clean-snapshot-reproduction"] },
    "oracleId": { "enum": ["official-release", "reconstructed-legacy"] },
    "rendererOracle": {
      "enum": ["captured-official-release", "captured-reconstructed-legacy"]
    },
    "originatingSave": {
      "type": "string",
      "pattern": "^saves/.+\\.(ftgd|ftgt)$"
    },
    "saveSha256": { "$ref": "#/$defs/sha256" },
    "freeTrainRevision": { "const": "r389" },
    "package": {
      "oneOf": [
        { "$ref": "#/$defs/officialPackage" },
        { "$ref": "#/$defs/reconstructedPackage" }
      ]
    },
    "environment": { "$ref": "#/$defs/environment" },
    "state": { "$ref": "#/$defs/state" },
    "interaction": { "$ref": "#/$defs/interaction" },
    "capture": { "$ref": "#/$defs/capture" },
    "comparison": { "$ref": "#/$defs/comparisonRegions" },
    "provenanceNotes": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "officialPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "archiveFilename",
        "archiveSha256",
        "executableSha256",
        "relevantPayloads"
      ],
      "properties": {
        "kind": { "const": "official-release" },
        "archiveFilename": { "const": "FreeTrain20070604.zip" },
        "archiveSha256": {
          "const": "70374a836a9f1bc28b16dd65c323fc1b21b4142f10344d19335a65690c16c23d"
        },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "relevantPayloads": {
          "type": "array",
          "items": { "$ref": "#/$defs/payloadHash" }
        }
      }
    },
    "reconstructedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "gitCommit",
        "preservationBuildIdentifier",
        "packageManifestSha256",
        "executableSha256",
        "relevantPayloads"
      ],
      "properties": {
        "kind": { "const": "reconstructed-legacy" },
        "gitCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "preservationBuildIdentifier": {
          "type": "string",
          "minLength": 1
        },
        "packageManifestSha256": { "$ref": "#/$defs/sha256" },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "relevantPayloads": {
          "type": "array",
          "items": { "$ref": "#/$defs/payloadHash" }
        }
      }
    },
    "payloadHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equivalenceGroupId",
        "identifier",
        "vmRole",
        "referenceStateIdentifier",
        "networkDisconnected",
        "guestOs",
        "clrDotNetVersions",
        "directXRuntime",
        "hypervisor",
        "display",
        "desktop"
      ],
      "properties": {
        "equivalenceGroupId": { "type": "string", "minLength": 1 },
        "identifier": { "type": "string", "minLength": 1 },
        "vmRole": { "enum": ["official-release", "reconstructed-legacy"] },
        "referenceStateIdentifier": { "type": "string", "minLength": 1 },
        "networkDisconnected": { "const": true },
        "guestOs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product", "version", "servicePack", "architecture"],
          "properties": {
            "product": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "servicePack": { "const": "SP3" },
            "architecture": { "const": "x86" }
          }
        },
        "clrDotNetVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "directXRuntime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "dx8vbDllVersion", "dx8vbDllSha256"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "dx8vbDllVersion": { "type": "string", "minLength": 1 },
            "dx8vbDllSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "hypervisor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product",
            "version",
            "graphicsController",
            "videoMemoryMiB",
            "acceleration3d",
            "guestDisplayDriver",
            "guestAdditions"
          ],
          "properties": {
            "product": { "const": "Oracle VM VirtualBox" },
            "version": { "type": "string", "minLength": 1 },
            "graphicsController": { "type": "string", "minLength": 1 },
            "videoMemoryMiB": { "type": "integer", "minimum": 1 },
            "acceleration3d": { "type": "boolean" },
            "guestDisplayDriver": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              }
            },
            "guestAdditions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["present", "version"],
              "properties": {
                "present": { "type": "boolean" },
                "version": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "colorDepthBits", "dpi", "scaling"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "colorDepthBits": { "type": "integer", "minimum": 1 },
            "dpi": { "type": "integer", "minimum": 1 },
            "scaling": { "const": "none" }
          }
        },
        "desktop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["theme", "wallpaper", "fontSmoothing"],
          "properties": {
            "theme": { "type": "string", "minLength": 1 },
            "wallpaper": { "type": "string", "minLength": 1 },
            "fontSmoothing": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clockDisplay",
        "clockPaused",
        "dayNight",
        "season",
        "weather",
        "heightCut",
        "controller",
        "overlays",
        "stationNames",
        "viewport",
        "cameraRotation"
      ],
      "properties": {
        "clockDisplay": { "type": "string", "minLength": 1 },
        "clockPaused": { "const": true },
        "dayNight": {
          "enum": ["align-clock-day", "align-clock-night", "always-day", "always-night"]
        },
        "season": { "enum": ["spring", "summer", "autumn", "winter"] },
        "weather": { "const": "none" },
        "heightCut": { "type": "string", "minLength": 1 },
        "controller": { "type": "string", "minLength": 1 },
        "overlays": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "stationNames": { "enum": ["on", "off"] },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mapWindowState", "scrollX", "scrollY", "mapClientRegion"],
          "properties": {
            "mapWindowState": { "type": "string", "minLength": 1 },
            "scrollX": { "type": "integer", "minimum": 0 },
            "scrollY": { "type": "integer", "minimum": 0 },
            "mapClientRegion": { "$ref": "#/$defs/rectangle" }
          }
        },
        "cameraRotation": { "const": "none" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "coordinateSpace", "points", "cursorDisposition", "notes"],
      "properties": {
        "mode": {
          "enum": ["parked", "pointer-hover", "click-move-preview", "drag-preview"]
        },
        "coordinateSpace": { "const": "full-screen-png" },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/interactionPoint" }
        },
        "cursorDisposition": {
          "enum": ["outside-deterministic-regions", "masked", "not-captured-by-hypervisor"]
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "interactionPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "x", "y"],
      "properties": {
        "role": {
          "enum": ["pointer", "anchor-click", "current-pointer", "drag-start", "drag-end"]
        },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "screenshot", "screenshotSha256", "format", "lossless"],
      "properties": {
        "mechanism": { "const": "hypervisor-console" },
        "screenshot": {
          "type": "string",
          "pattern": "^screenshots/(official-release|reconstructed-legacy)/(primary|reproduction)/.+\\.png$"
        },
        "screenshotSha256": { "$ref": "#/$defs/sha256" },
        "format": { "const": "png" },
        "lossless": { "const": true }
      }
    },
    "comparisonRegions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministicRegions",
        "gdiFontRegions",
        "pointerCursorRegions",
        "maskArtifacts"
      ],
      "properties": {
        "deterministicRegions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/region" }
        },
        "gdiFontRegions": {
          "type": "array",
          "items": { "$ref": "#/$defs/reviewRegion" }
        },
        "pointerCursorRegions": {
          "type": "array",
          "items": { "$ref": "#/$defs/reviewRegion" }
        },
        "maskArtifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/maskArtifact" }
        }
      }
    },
    "rectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionId", "x", "y", "width", "height", "purpose"],
      "properties": {
        "regionId": { "$ref": "#/$defs/stableId" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "reviewRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionId", "x", "y", "width", "height", "purpose", "action"],
      "properties": {
        "regionId": { "$ref": "#/$defs/stableId" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "action": { "enum": ["mask", "manual-review"] }
      }
    },
    "maskArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^masks/.+" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
